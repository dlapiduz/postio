{
    "app-id": "dev.postio.Postio",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "postio",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets",
        "--filesystem=xdg-data/postio:create",
        "--filesystem=xdg-config/postio:create",
        "--filesystem=xdg-download"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/postio/cargo",
            "CARGO_NET_OFFLINE": "true",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "cc",
            "CC": "cc",
            "RUSTC_WRAPPER": "",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C linker-flavor=gcc"
        }
    },
    "modules": [
        {
            "name": "postio",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --ignore-rust-version --release --package postio-app --bin postio",
                "install -Dm755 target/release/postio /app/bin/postio",
                "install -Dm644 crates/postio-focus/data/dev.postio.Postio.desktop /app/share/applications/dev.postio.Postio.desktop",
                "install -Dm644 crates/postio-widgets/data/icons/48x48/apps/dev.postio.Postio.png /app/share/icons/hicolor/48x48/apps/dev.postio.Postio.png",
                "install -Dm644 crates/postio-widgets/data/icons/64x64/apps/dev.postio.Postio.png /app/share/icons/hicolor/64x64/apps/dev.postio.Postio.png",
                "install -Dm644 crates/postio-widgets/data/icons/128x128/apps/dev.postio.Postio.png /app/share/icons/hicolor/128x128/apps/dev.postio.Postio.png",
                "install -Dm644 crates/postio-widgets/data/icons/16x16/apps/dev.postio.Postio.png /app/share/icons/hicolor/16x16/apps/dev.postio.Postio.png",
                "install -Dm644 crates/postio-widgets/data/icons/32x32/apps/dev.postio.Postio.png /app/share/icons/hicolor/32x32/apps/dev.postio.Postio.png",
                "install -Dm644 crates/postio-widgets/data/icons/scalable/apps/dev.postio.Postio.svg /app/share/icons/hicolor/scalable/apps/dev.postio.Postio.svg",
                "install -Dm644 crates/postio-widgets/data/icons/scalable/apps/dev.postio.Postio-symbolic.svg /app/share/icons/hicolor/symbolic/apps/dev.postio.Postio-symbolic.svg",
                "install -Dm644 crates/postio-focus/data/dev.postio.Postio.metainfo.xml /app/share/metainfo/dev.postio.Postio.metainfo.xml",
                "cargo --offline build --release --package postio-focus --bin postio-focus",
                "install -Dm755 target/release/postio-focus /app/bin/postio-focus",
                "install -Dm644 crates/postio-focus/data/dev.postio.Postio.Focus.desktop /app/share/applications/dev.postio.Postio.Focus.desktop"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        "target",
                        ".git",
                        "flatpak"
                    ]
                },
                "cargo-sources.json"
            ]
        }
    ]
}