[Desktop Entry]
Type=Application
Name=Postio Focus
GenericName=Email Client
Comment=A dense, keyboard-first inbox for a lot of email
Exec=postio-focus %U
Icon=dev.postio.Postio
Terminal=false
Categories=Network;Email;GTK;
Keywords=Email;E-mail;Mail;IMAP;Inbox;Digest;Focus;
MimeType=x-scheme-handler/postio;
StartupNotify=true
StartupWMClass=dev.postio.Postio.Focus
