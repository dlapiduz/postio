<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Postio</string>
	<key>CFBundleDisplayName</key>
	<string>Postio</string>
	<key>CFBundleExecutable</key>
	<string>Postio</string>
	<!-- The same identifier the Keychain files items under, and deliberately
	     stable: an unsigned build's code identity changes on every rebuild,
	     and a changing bundle id on top of that would make every launch look
	     like a different application to the Keychain. -->
	<key>CFBundleIdentifier</key>
	<string>dev.postio.Postio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.2</string>
	<key>CFBundleVersion</key>
	<string>0.4.2</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Not an agent: Postio is a window, not a menu-bar item. -->
	<key>LSUIElement</key>
	<false/>
	<!-- Generated by scripts/macos-icon.swift from the same SVG the GTK
	     frontend ships, never redrawn. The extension is omitted because
	     that is the convention and Launch Services adds `.icns`. -->
	<key>CFBundleIconFile</key>
	<string>Postio</string>
	<!-- Recipient completion asks for Contacts once, on the first
	     keystroke in a recipient field (specs/009-focus-macos T078). Names
	     and email addresses only, read for each answer and kept nowhere. -->
	<key>NSContactsUsageDescription</key>
	<string>Postio suggests recipients from your contacts as you type an address. Names and email addresses are read on this Mac, only while you type, and are never stored or sent anywhere.</string>
	<!-- What makes Postio *the* mail client on a machine rather than *a*
	     mail client on it. The GTK side claims the same thing through its
	     .desktop file's `x-scheme-handler/mailto`.

	     `Viewer` rather than `Owner`: nobody owns `mailto:`, and claiming
	     to would be this application asserting a priority over every other
	     mail client that macOS is right to ignore. The user picks the
	     default in System Settings; this declares Postio eligible. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Mail Address</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Postio Message Link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>postio</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
