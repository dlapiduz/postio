/target
# A private target directory, which docs/engineering-notes.md recommends for a
# result you are going to stake a merge on. See #76.
/target-*/
**/*.rs.bk
*.pdb
.flatpak-builder/
/build/
/repo/
/flatpak/build-dir/
/flatpak/.flatpak-builder/
/flatpak/cargo-sources.json

.claude/hooks/guard.log

# Beads' interaction log. The tracker is retired and nothing reads this, but
# the file is still written locally and dirtied the tree on every session --
# blocking rebases and interrupting pushes. Kept on disk, out of git.
# The retired beads tracker's local state, if the bd tool ever runs here
# again. Nothing from it is tracked.
.beads/

# Python bytecode, including the agent hooks .
__pycache__/
*.pyc

# Generated by scripts/check-portal-drag-flatpak.sh: the real manifest plus
# the commands that build and install the in-sandbox portal check. Derived,
# never edited -- see the script for why it is not a second committed manifest.
flatpak/dev.postio.Postio.Check.json
