+            // SQLCipher's crypto provider is pluggable and this crate has
+            // no way to say so. Everything below finds, includes and links a
+            // crypto library, and the amalgamation falls back to OpenSSL
+            // when none of its four provider macros is defined.
+            //
+            // `SQLCIPHER_CRYPTO_CUSTOM` names a setup function the caller
+            // supplies -- `int SQLCIPHER_CRYPTO_CUSTOM(sqlcipher_provider *)`
+            // -- so a downstream crate can fill the provider table itself
+            // and there is no crypto library to find at all. The symbol
+            // resolves at the final link, like any other extern.
+            //
+            // A labelled block rather than an `else` so the diff is the
+            // lines that are new; an upstream patch would indent the rest.
+            'crypto: {
+            println!("cargo:rerun-if-env-changed=LIBSQLITE3_SYS_CRYPTO_CUSTOM");
+            if let Some(setup) = env::var_os("LIBSQLITE3_SYS_CRYPTO_CUSTOM") {
+                cfg.flag(&format!(
+                    "-DSQLCIPHER_CRYPTO_CUSTOM={}",
+                    setup.to_string_lossy()
+                ));
+                break 'crypto;
+            }
+
             let target = env::var("TARGET").unwrap();
             let host = env::var("HOST").unwrap();
 
