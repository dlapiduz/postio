A delimiter line holds only padding after the boundary

1.0.1 matched a delimiter at the start of a line and stopped checking
at the first space or tab after the boundary, and took `--boundary--`
as a close whatever followed it. So a body line such as
`--SEP this is not a delimiter` or `--SEP--x` ended the part, and the
rest of the text was lost without a flag (Postio #899). RFC 2046
section 5.1.1 allows only linear whitespace between the boundary (or
the close delimiter's `--`) and the end of the line; this checks the
whole of it. The same check stops an outer boundary from closing on
an inner one that extends it with `--`.

Not sent upstream (the maintainer's call, 2026-11-22). Drop it when a
release matches only whole delimiter lines.

diff -ruN mail-parser/src/parser/delimiter.rs mail-parser/src/parser/delimiter.rs
--- mail-parser/src/parser/delimiter.rs
+++ mail-parser/src/parser/delimiter.rs
@@ -20,11 +20,22 @@
 impl Delimiter {
     pub(crate) fn at_line(raw: &[u8], line: usize, frame: usize, boundary: &[u8]) -> Option<Self> {
         let after_dashes = raw.get(line..)?.strip_prefix(b"--")?;
-        let is_close = match strip_boundary(after_dashes, boundary)? {
-            [b'-', b'-', ..] => true,
-            [] | [b'\n' | b'\r' | b' ' | b'\t', ..] => false,
-            _ => return None,
+        let after_boundary = strip_boundary(after_dashes, boundary)?;
+        let (is_close, padding) = match after_boundary.strip_prefix(b"--") {
+            Some(rest) => (true, rest),
+            None => (false, after_boundary),
         };
+        // RFC 2046 section 5.1.1: after the boundary (and the close
+        // delimiter's "--") only transport padding, linear whitespace, may
+        // come before the line ends. A line that merely starts with the
+        // delimiter is body text.
+        let end = padding
+            .iter()
+            .position(|&byte| byte != b' ' && byte != b'\t')
+            .unwrap_or(padding.len());
+        if !matches!(padding.get(end), None | Some(b'\n' | b'\r')) {
+            return None;
+        }
         Some(Delimiter {
             frame,
             line,
@@ -114,6 +125,13 @@
         assert!(at(24).is_some_and(|d| !d.is_close));
         assert!(at(32).is_some_and(|d| !d.is_close && d.next == raw.len()));
         assert!(at(0).is_none());
+
+        let raw = b"--BND not one\n--BND\tnor\n--BND--x\n--BND-- \r\n";
+        let at = |line| Delimiter::at_line(raw, line, 0, b"BND");
+        assert!(at(0).is_none());
+        assert!(at(14).is_none());
+        assert!(at(24).is_none());
+        assert!(at(33).is_some_and(|d| d.is_close));
     }
 
