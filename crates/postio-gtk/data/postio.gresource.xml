<?xml version="1.0" encoding="UTF-8"?>
<!--
  Everything the UI needs at runtime, compiled into the binary.

  Paths are relative to `data/`, the sourcedir build.rs passes to
  glib-compile-resources. The vendored fonts and the reader's own
  stylesheets are not here: they are `postio-ui`'s data (#799, ADR 0023),
  embedded directly where that crate reads them, so the bytes have one
  owner instead of a second copy in this bundle.
-->
<gresources>
  <gresource prefix="/dev/postio/Postio">
    <!-- Generated from the Industry design system by build.rs. -->
    <file compressed="true">tokens.css</file>

    <!-- Hand-written, and layered on top of the generated tokens. -->
    <file compressed="true">shell.css</file>

    <!-- The application icon, in the directory layout GtkIconTheme expects
         under a resource path: <path>/<size>/<context>/<name>.svg. -->
    <file compressed="true">icons/scalable/apps/dev.postio.Postio.svg</file>
    <file compressed="true">icons/scalable/apps/dev.postio.Postio-symbolic.svg</file>
    <file compressed="true">icons/scalable/actions/postio-archive-symbolic.svg</file>
  </gresource>
</gresources>
