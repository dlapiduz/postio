{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shared-tree.py\"",
            "statusMessage": "Checking shared-tree safety"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(pkg-config:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo run:*)",
      "Bash(cargo add:*)",
      "Bash(rustfmt:*)",
      "Bash(python3 scripts/check-crate-boundaries.py:*)",
      "Bash(python3 scripts/check-no-personal-data.py:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git remote -v:*)",
      "Bash(git remote get-url:*)",
      "Bash(git push:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh label:*)",
      "Bash(scripts/issue-claim.sh:*)",
      "Bash(scripts/issue-land.sh:*)",
      "Bash(scripts/issue-release.sh:*)",
      "Bash(scripts/test-headless.sh:*)",
      "Bash(python3 scripts/check-no-silent-tracking.py:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue close:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow run:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git rebase origin/main:*)",
      "Bash(git pull:*)",
      "Bash(git restore:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  }
}
